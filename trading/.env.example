# Market data source: "sim" (synthetic, works offline) or "alpaca" (real IEX quotes, free account)
DATA_SOURCE=sim
# Broker: "paper" (local realistic simulator). "alpaca-paper" / "alpaca-live" are planned next steps.
BROKER=paper

ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

SYMBOLS=AAPL,MSFT,NVDA,TSLA,AMD,SPY,QQQ
PORT=4000

# Paper account
STARTING_CASH=5000
ACCOUNT_TYPE=margin          # margin | cash
# intraday = FINRA intraday margin standards (in effect since 2026-06-04: no $25K / day-trade count,
#            $2,000 minimum for margin, 25% long / 30% short requirement)
# pdt      = legacy pattern-day-trader rule, for brokers still phasing in the change (until 2027-10-20)
MARGIN_MODEL=intraday
SLIPPAGE_BPS=2               # extra price paid on market/stop fills, in basis points

# Fees — defaults are IBKR Pro "Fixed" pricing plus pass-through regulatory fees
COMMISSION_PER_SHARE=0.005
MIN_COMMISSION=1             # per order
MAX_COMMISSION_PCT=0.01      # cap: 1% of trade value
SEC_FEE_PER_MILLION=20.6     # SEC Section 31, on sales (FY2026 rate from 2026-04-04)
FINRA_TAF_PER_SHARE=0.000195 # FINRA Trading Activity Fee, on sales
FINRA_TAF_MAX=9.79           # per trade

# Risk limits (sized for a $5,000 account)
MAX_DAILY_LOSS=150           # new opening orders blocked once day P&L <= -this
MAX_RISK_PER_TRADE=50        # every new position needs a stop; loss to the stop capped at this. 0 disables
MAX_POSITION_NOTIONAL=10000  # per symbol
MAX_ORDER_NOTIONAL=10000
FLATTEN_MINUTES_BEFORE_CLOSE=5   # 0 disables auto-flatten (only applies with real market hours)
